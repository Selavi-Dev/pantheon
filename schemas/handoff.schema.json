{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pantheon immutable handoff proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "handoff_id", "idempotency_key", "source_agent", "target_agent", "entity", "project", "objective", "constraints", "acceptance_criteria", "evidence", "due_at", "authorization_required"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "handoff_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "source_agent": {"type": "string", "minLength": 1},
    "target_agent": {"type": "string", "minLength": 1},
    "entity": {"type": "string", "minLength": 1},
    "project": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "constraints": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "due_at": {"type": ["string", "null"], "format": "date-time"},
    "authorization_required": {"const": true}
  }
}
